{
  "kind": "collectionType",
  "collectionName": "produtos",
  "info": {
    "singularName": "produto",
    "pluralName": "produtos",
    "displayName": "Produto"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "descricao": {
      "type": "text"
    },
    "preco": {
      "type": "decimal",
      "required": true,
      "min": 0
    },
    "disponivel": {
      "type": "boolean",
      "default": true
    },
    "imagem": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "feirante": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::feirante.feirante",
      "inversedBy": "produtos"
    }
  }
}
